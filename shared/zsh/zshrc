# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
alias zshconfig="vim ~/.zshrc"
alias sourcezsh="source ~/.zshrc"
alias vim="nvim"
alias knvim="NVIM_APPNAME=kvim nvim"
alias python="python3"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# load fzf configration
[ -f ~/.config/z/z.sh ] && source ~/.config/z/z.sh
[ -f ~/.config/fzf/fzf.zsh ] && source ~/.config/fzf/fzf.zsh

[ -f "$HOME/.ghcup/env" ] && . "$HOME/.ghcup/env" # ghcup-env

# zsh loading script order
# .zshenv: 每次启动Zsh时都会加载。
# .zprofile: 仅在登录Shell启动时加载。
# .zshrc: 仅在交互式Shell启动时加载。
# .zlogin: 仅在登录Shell启动时加载，且在.zshrc之后。
# .zlogout: 仅在退出登录Shell时加载。
# Created by `pipx` on 2024-12-06 11:24:25
export PATH="$PATH:$HOME/.local/bin"

[[ "$TERM_PROGRAM" == "kiro" ]] && command -v kiro >/dev/null 2>&1 && . "$(kiro --locate-shell-integration-path zsh)"
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
export PATH="$HOME/.ghcup/bin:$PATH"

# pnpm
if [[ "$OSTYPE" == darwin* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
