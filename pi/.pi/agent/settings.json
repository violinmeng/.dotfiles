{
  "theme": "omp-titanium",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 2,
  "powerline": {
    "preset": "default",
    "placement": "above",
    "welcome": true
  },
  "piVim": {
    "modeColors": {
      "insert": "success",
      "normal": "borderAccent",
      "visual": "warning",
      "ex": "error"
    },
    "borderSync": {
      "insert": "host",
      "normal": "host",
      "visual": "mode",
      "ex": "mode"
    }
  },
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "hideThinkingBlock": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "packages": [
    {
      "source": "npm:pi-vim@0.14.1",
      "extensions": []
    },
    "npm:pi-web-access@0.18.0",
    "npm:pi-mcp-adapter@2.20.1",
    {
      "source": "npm:@pi-archimedes/diff@1.8.3",
      "extensions": []
    },
    {
      "source": "npm:@pi-archimedes/image-paste@1.8.3",
      "extensions": []
    },
    {
      "source": "npm:@mariozechner/clipboard@0.3.9",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "npm:pi-powerline-footer@0.12.1",
    "npm:pi-openai-fast-mode@0.3.0",
    "git:github.com/algal/pi-openai-server-compaction@8a3de2f3b0c178fdd6f73f2f94172dfc3943e466",
    "npm:pi-tool-display@0.5.0",
    "npm:pi-code-previews@0.1.36"
  ],
  "lastChangelogVersion": "0.84.0"
}